Visualization Manager:
  Class: ""
  Enabled: true
  Name: root

  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30

  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane: XY
      Plane Cell Count: 10
      Color: 160; 160; 160
      Alpha: 1.0

    - Class: rviz/TF
      Name: TF
      Enabled: true
      Frame Timeout: 15
      Show Axes: true
      Show Arrows: true
      Show Names: false
      Marker Scale: 1.0

  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select

  Views:
    Current:
      Class: rviz/Orbit
      Name: Orbit
      Distance: 5
      Pitch: 0.6
      Yaw: 1.0
      Target Frame: map
      Focal Point:
        X: 0
        Y: 0
        Z: 0
