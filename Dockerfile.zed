# ============================================================
# Isaac ROS Humble (base oficial NVIDIA)
# ============================================================
FROM nvcr.io/nvidia/isaac/ros:x86_64-ros2_humble_f247dd1051869171c3fc53bb35f6b907

# Evita conflitos antigos (ex: yarn)
RUN rm -f /etc/apt/sources.list.d/yarn*.list || true

ENV DEBIAN_FRONTEND=noninteractive
SHELL ["/bin/bash", "-c"]

# ============================================================
# Locale + utilitários básicos
# ============================================================
RUN apt-get update && apt-get install -y \
    locales \
    curl \
    wget \
    git \
    lsb-release \
    gnupg \
    udev \
    usbutils \
    && locale-gen en_US.UTF-8 \
    && update-locale LC_ALL=en_US.UTF-8 LANG=en_US.UTF-8 \
    && rm -rf /var/lib/apt/lists/*

# ============================================================
# Dependências ROS necessárias para ZED
# ============================================================
RUN apt-get update && apt-get install -y \
    ros-humble-image-transport \
    ros-humble-camera-info-manager \
    ros-humble-compressed-image-transport \
    ros-humble-diagnostic-updater \
    ros-humble-vision-msgs \
    ros-humble-rviz2 \
    ros-humble-xacro \
    ros-humble-robot-state-publisher \
    ros-humble-joint-state-publisher \
    ros-humble-magic-enum \
    python3-colcon-common-extensions \
    python3-rosdep \
    python3-vcstool \
    && rm -rf /var/lib/apt/lists/*

# ============================================================
# Instalar ZED SDK Oficial (Ubuntu 22.04 + CUDA 12)
# ============================================================

# Versão estável
ENV ZED_SDK_VERSION=5.0


RUN wget -q https://download.stereolabs.com/zedsdk/${ZED_SDK_VERSION}/cu12/ubuntu22 \
    -O /tmp/ZED_SDK.run && \
    chmod +x /tmp/ZED_SDK.run && \
    /tmp/ZED_SDK.run silent skip_tools skip_cuda && \
    rm -f /tmp/ZED_SDK.run

# ============================================================
# Variáveis de ambiente ZED
# ============================================================
ENV ZED_SDK_ROOT_DIR=/usr/local/zed
ENV CMAKE_PREFIX_PATH=/usr/local/zed:$CMAKE_PREFIX_PATH
ENV LD_LIBRARY_PATH=/usr/local/zed/lib:$LD_LIBRARY_PATH
ENV ISAAC_ROS_WS=/home/spot-teleop/zed_ws:$ISAAC_ROS_WS

# ============================================================
# Workspace
# ============================================================
WORKDIR /home/spot-teleop/zed_ws
RUN mkdir -p src

# ROS environment
RUN echo "source /opt/ros/humble/setup.bash" >> /root/.bashrc

CMD ["/bin/bash"]
